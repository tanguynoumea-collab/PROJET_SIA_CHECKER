<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>4.0.0</Version>
    <Product>SIA Check Viewer</Product>
    <Company>HRS Real Estate AG</Company>
    <Description>Contrôle par sommation des surfaces SIA 416 / USPI des projets Treegram</Description>
    <!-- Logo : scripts/make_logo.py -->
    <ApplicationIcon>Assets\SiaCheck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SiaCheck.ico" />
    <Resource Include="Assets\SiaCheck.png" />
    <Resource Include="Assets\SiaCheckMark.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SiaCheck.Viewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Revue IA : la procédure de Claude Code sert de prompt, le rapport de L'Orée d'exemple de forme -->
    <EmbeddedResource Include="..\..\.claude\skills\revue-ia\SKILL.md" LogicalName="SiaCheck.Viewer.Prompts.revue-ia.SKILL.md" />
    <EmbeddedResource Include="..\..\docs\revue-ia\L_OREE_2026-10-22.md" LogicalName="SiaCheck.Viewer.Prompts.revue-ia.exemple.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dashboard du benchmark : la page web du dépôt (dashboard/), affichée par WebView2 et publiée telle quelle sur le web -->
    <Content Include="..\..\dashboard\*.html;..\..\dashboard\*.css;..\..\dashboard\*.js" Link="dashboard\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.1.0" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
