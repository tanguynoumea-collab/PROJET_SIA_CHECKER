<!-- Thème « Mint » — fresh &amp; refreshing (source : @uiuxaadi · DfKLpS_FLbN). Thème clair, mêmes clés que les autres Colors.*.xaml.
     Structure de Pervenche clair : panneaux et menus blancs, vue 3D à peine teintée, la palette pour l'accent et
     de légères teintes. Teintes de palette : texte #0B3D3B, accent #14B8A6, primaire #99F6E4, surface #E6FFFB, fond #F8FFFE ;
     les tons clairs sont la primaire (ou le texte) diluée dans du blanc, sans nouvelle couleur. Hors palette, seules
     les couleurs d'état (succès, alerte, erreur) et la couleur de contenu SA (légende SIA 416). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fond de page et de la vue 3D : 10 % de primaire -->
    <Color x:Key="ColorBackground">#F5FEFC</Color>
    <!-- Panneaux et menus -->
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <!-- Cartes, survol, puces : 30 % de primaire -->
    <Color x:Key="ColorSurfaceRaised">#E0FCF7</Color>
    <Color x:Key="ColorTextPrimary">#0B3D3B</Color>
    <!-- Texte secondaire : 74 % de texte (≥ 4,5:1 sur blanc, cartes et sélection) -->
    <Color x:Key="ColorTextSecondary">#4A6F6E</Color>
    <Color x:Key="ColorAccent">#14B8A6</Color>
    <Color x:Key="ColorOnAccent">#0B3D3B</Color>
    <!-- Liens et icônes d'action : l'accent assombri de moitié vers le texte (≥ 4,5:1, l'accent seul fait 2,5:1) -->
    <Color x:Key="ColorAccentText">#107A70</Color>
    <Color x:Key="ColorVerdictError">#C62F2F</Color>
    <Color x:Key="ColorVerdictWarning">#9A6700</Color>
    <!-- Information : pas une couleur d'état, donc le texte secondaire -->
    <Color x:Key="ColorVerdictInfo">#4A6F6E</Color>
    <Color x:Key="ColorStatusSeen">#1E7F52</Color>
    <!-- Couleur de contenu : abords SA (légende SIA 416 §1.2), découpes vers SA (Évolution 2.0) -->
    <Color x:Key="ColorSiaSA">#3F8A2C</Color>
    <Color x:Key="ColorContext">#380B3D3B</Color>
    <!-- Filets : 15 % de texte -->
    <Color x:Key="ColorDivider">#DAE2E2</Color>
    <Color x:Key="ColorGhost">#260B3D3B</Color>
    <!-- Puce cochée (bâtiment, onglet, filtre) : 60 % de primaire, bordée d'accent -->
    <Color x:Key="ColorSelected">#C2FAEF</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="BrushVerdictError" Color="{StaticResource ColorVerdictError}" />
    <SolidColorBrush x:Key="BrushVerdictWarning" Color="{StaticResource ColorVerdictWarning}" />
    <SolidColorBrush x:Key="BrushVerdictInfo" Color="{StaticResource ColorVerdictInfo}" />
    <SolidColorBrush x:Key="BrushStatusSeen" Color="{StaticResource ColorStatusSeen}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
    <SolidColorBrush x:Key="BrushSiaSA" Color="{StaticResource ColorSiaSA}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />
    <SolidColorBrush x:Key="BrushSelected" Color="{StaticResource ColorSelected}" />
    <SolidColorBrush x:Key="BrushOnSelected" Color="{StaticResource ColorTextPrimary}" />

    <!-- ===== Contrôles WPF-UI (boutons, listes, champs, menus) : texte du thème Fluent en noir et texte blanc sur
         l'accent. App.ApplyTheme recopie ces clés au premier niveau, devant le thème et l'accent. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F5FEFC" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F0FEFB" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E0FCF7" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F0FEFB" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E0FCF7" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E0FCF7" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E0FCF7" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#DAE2E2" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A6F6E" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#718E8D" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#4A6F6E" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="#0B3D3B" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#0B3D3B" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#0B3D3B" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#107A70" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#107A70" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#107A70" />
</ResourceDictionary>
