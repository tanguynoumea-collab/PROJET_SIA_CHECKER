<ui:FluentWindow x:Class="SiaCheck.Viewer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:h="http://helix-toolkit.org/wpf"
                 xmlns:c="clr-namespace:SiaCheck.Viewer.Controls"
                 xmlns:vm="clr-namespace:SiaCheck.Viewer.ViewModels"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="SIA Check Viewer"
                 Icon="pack://application:,,,/Assets/SiaCheck.ico"
                 MinWidth="{StaticResource WindowMinWidth}" MinHeight="{StaticResource WindowMinHeight}"
                 Background="{DynamicResource BrushBackground}"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeBody}">

    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding AnalyseCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleAiReportCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearFocusCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowSubjectsTabCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowPointsTabCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowSpacesTabCommand}" />
    </Window.InputBindings>

    <!-- Fond explicite : le gabarit FluentWindow applique sinon le fond du thème WPF UI, pas le token Background -->
    <Grid Background="{DynamicResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SIA Check Viewer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/SiaCheck.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ================================================================ ACCUEIL : Fiabilisation | Benchmark (plan §Évolution 3.0) -->
        <Grid Grid.Row="1" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" ClipToBounds="True">
            <!-- Filigrane : le logo (plaques seules), grand et pâle, calé dans le coin bas-gauche, derrière le contenu -->
            <Image Source="pack://application:,,,/Assets/SiaCheckMark.png" Height="740" Opacity="0.07"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-125"
                   IsHitTestVisible="False" Focusable="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Grid MaxWidth="{StaticResource HomeMaxWidth}" Margin="{StaticResource HomeMargin}">
                <!-- Génération plus étroite (liste courte : nom, état, date), Fiabilisation plus large (lignes chargées) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Génération (Évolution 4.0) : surfaces SIA d'une maquette architecte IFC -->
                <DockPanel Grid.Column="0" Margin="{StaticResource HomeColumnLeft}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource TextSection}" Margin="0" Text="Génération" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextTitle}" TextWrapping="Wrap"
                                   Text="Générer les surfaces SIA d'une maquette IFC." />
                        <ui:Button Margin="0,24,0,0" Appearance="Primary" Icon="{ui:SymbolIcon CubeAdd20}"
                                   Content="Générer depuis un IFC…" Command="{Binding GenerateFromIfcCommand}"
                                   MinHeight="{StaticResource TargetSize}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                   Text="La maquette doit contenir ses IfcSpace. Le projet généré s'ouvre ensuite dans la Fiabilisation." />
                        <DockPanel Margin="0,32,0,8" Visibility="{Binding GeneratedProjects.Count, Converter={StaticResource VisibleWhen}}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Text="{Binding GeneratedProjects.Count}" />
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" Text="Projets générés" />
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding GeneratedProjects}" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowClockwise20}"
                                                   VerticalAlignment="Center" MinHeight="{StaticResource TargetSize}"
                                                   Command="{Binding DataContext.RegenerateItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" ToolTip="{Binding Source}"
                                                   AutomationProperties.Name="Régénérer depuis la maquette" />
                                        <Button Style="{StaticResource RowButton}" Padding="{StaticResource RowPadding}"
                                                Command="{Binding DataContext.OpenGeneratedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource TextSubtitle}" Text="{Binding Name}" ToolTip="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Margin="8,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource BrushStatusSeen}"
                                                                   Visibility="{Binding IsSettled, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding StateText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                           Text="{Binding Date, StringFormat=dd.MM.yyyy}" />
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushDivider}" />

                <!-- Fiabilisation : contrôler et corriger un projet Treegram -->
                <DockPanel Grid.Column="2" Margin="{StaticResource HomeColumnMiddle}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource TextSection}" Margin="0" Text="Fiabilisation" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextTitle}" TextWrapping="Wrap"
                                   Text="Contrôler et corriger les surfaces d'un projet Treegram." />
                        <ui:Button Margin="0,24,0,0" Appearance="Primary" Icon="{ui:SymbolIcon FolderAdd20}"
                                   Content="Nouveau projet…" Command="{Binding NewProjectCommand}"
                                   MinHeight="{StaticResource TargetSize}" ToolTip="Ctrl+N" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                   Text="La fiche projet : le dossier Treegram (fichier .tgm et cache VWR) et l'identité HRS, reprise dans le MDP." />

                        <Border Margin="0,16,0,0" Style="{StaticResource Banner}" BorderBrush="{DynamicResource BrushVerdictError}"
                                Visibility="{Binding HomeError, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding HomeError}" />
                        </Border>

                        <DockPanel Margin="0,32,0,8" Visibility="{Binding Recents.Count, Converter={StaticResource VisibleWhen}}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Text="{Binding Recents.Count}" />
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" Text="Projets actifs" />
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Recents}" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Delete20}"
                                                   VerticalAlignment="Center" MinHeight="{StaticResource TargetSize}"
                                                   Command="{Binding DataContext.DeleteRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" ToolTip="Supprimer le projet de SIA Check (statuts, corrections, analyse, revues IA)"
                                                   AutomationProperties.Name="Supprimer le projet" />
                                        <!-- Fiche projet (Évolution 3.8) : identité et dossier, modifiables sans ouvrir le projet -->
                                        <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Edit20}"
                                                   VerticalAlignment="Center" MinHeight="{StaticResource TargetSize}"
                                                   Command="{Binding DataContext.EditProjectSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" ToolTip="Fiche projet : identité HRS et dossier Treegram"
                                                   AutomationProperties.Name="Fiche projet" />
                                        <!-- Un projet traité nourrit la base du benchmark -->
                                        <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon DatabaseArrowRight20}"
                                                   VerticalAlignment="Center" MinHeight="{StaticResource TargetSize}"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                                                   Command="{Binding DataContext.AddToBaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Ajouter à la base : exporte le MDP du projet (surfaces corrigées) dans le dossier de la base du benchmark"
                                                   AutomationProperties.Name="Ajouter à la base" />
                                        <Button Style="{StaticResource RowButton}" Padding="{StaticResource RowPadding}"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" MinWidth="100" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding IdText}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource TextSubtitle}" Text="{Binding DisplayName}" ToolTip="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Typologie et canton, comme la liste de la base ; sinon ce qui manque (✎ pour compléter) -->
                                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource HiddenWhen}}">
                                                    <Run Text="{Binding TypologieText, Mode=OneWay}" /><Run Text="  " /><Run FontFamily="{StaticResource FontMono}" Text="{Binding CantonText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushVerdictWarning}" Text="{Binding Warning}"
                                                           ToolTip="Cliquez sur ✎ pour compléter la fiche projet"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding StatusLabel}" ToolTip="Statut du projet">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusSeen}" />
                                                                </DataTrigger>
                                                                <!-- Traité · modifié : à republier (⇥ ou clic sur le statut dans le projet) -->
                                                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Style="{StaticResource TextCaption}">
                                                    <Run Text="{Binding IssueCount, Mode=OneWay}" /><Run Text=" points · " /><Run Text="{Binding LastAnalysis, StringFormat=dd.MM.yyyy, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="3" Width="1" Background="{DynamicResource BrushDivider}" />

                <!-- Benchmark : comparer un projet à ceux qui lui ressemblent -->
                <DockPanel Grid.Column="4" Margin="{StaticResource HomeColumnRight}" Grid.IsSharedSizeScope="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource TextSection}" Margin="0" Text="Benchmark" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextTitle}" TextWrapping="Wrap"
                                   Text="Comparer un projet à ceux qui lui ressemblent." />
                        <ui:Button Margin="0,24,0,0" Appearance="Primary" Icon="{ui:SymbolIcon ChartMultiple20}"
                                   Content="Ouvrir le benchmark" Command="{Binding OpenBenchmarkCommand}"
                                   MinHeight="{StaticResource TargetSize}"
                                   ToolTipService.ShowOnDisabled="True"
                                   ToolTip="Comparer les projets de la base (choisissez d'abord le dossier de la base)" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextCaption}" Text="{Binding BenchmarkSummary}"
                                   Visibility="{Binding BenchmarkSummary, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushVerdictWarning}"
                                   Text="{Binding BenchmarkWarning}" TextWrapping="Wrap"
                                   Visibility="{Binding BenchmarkWarning, Converter={StaticResource VisibleWhen}}" />

                        <DockPanel Margin="0,32,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Visibility="{Binding HasBenchmarkFolder, Converter={StaticResource BoolToVisibility}}">
                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowClockwise20}" MinHeight="{StaticResource TargetSize}"
                                           Command="{Binding RefreshBenchmarkCommand}" ToolTip="Relire la base"
                                           AutomationProperties.Name="Relire la base" />
                                <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen20}" MinHeight="{StaticResource TargetSize}"
                                           Command="{Binding ChooseBenchmarkFolderCommand}" ToolTip="{Binding BenchmarkFolderTooltip}"
                                           AutomationProperties.Name="Changer le dossier de la base" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" VerticalAlignment="Center" Text="Base de données" />
                        </DockPanel>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsBenchmarkLoading, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Height="2" IsIndeterminate="True" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" Text="{Binding BenchmarkActivity}" />
                        </StackPanel>

                        <!-- Aucun dossier choisi : une invitation à la place de la liste -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasBenchmarkFolder, Converter={StaticResource HiddenWhen}}">
                            <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap"
                                       Text="Choisissez le dossier qui contient les MDP du benchmark." />
                            <ui:Button Margin="0,12,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen20}"
                                       Content="Choisir le dossier…" Command="{Binding ChooseBenchmarkFolderCommand}"
                                       MinHeight="{StaticResource TargetSize}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding BenchmarkEmptyMessage}"
                                   Visibility="{Binding BenchmarkEmptyMessage, Converter={StaticResource VisibleWhen}}" />
                        <Border Margin="0,8,0,0" Style="{StaticResource Banner}" BorderBrush="{DynamicResource BrushVerdictError}"
                                Visibility="{Binding BenchmarkError, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding BenchmarkError}" />
                        </Border>
                    </StackPanel>

                    <!-- En-tête : un clic trie la liste sur la colonne (même colonne : sens inversé) -->
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4"
                          Visibility="{Binding BenchmarkProjects.Count, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseFingerprint" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource RowButton}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <!-- Pas de focus clavier au clic : sinon le cadre d'accent reste autour de l'en-tête -->
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Command" Value="{Binding SortBaseCommand}" />
                            </Style>
                        </Grid.Resources>
                        <Button Style="{StaticResource SortHeader}" CommandParameter="id" ToolTip="Trier par ID">
                            <TextBlock Style="{StaticResource TextCaption}"><Run Text="ID" /><Run Text=" " /><Run FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SortArrowId, Mode=OneWay}" /></TextBlock>
                        </Button>
                        <Button Grid.Column="1" Margin="8,0" Style="{StaticResource SortHeader}" CommandParameter="nom" ToolTip="Trier par nom">
                            <TextBlock Style="{StaticResource TextCaption}"><Run Text="Projet" /><Run Text=" " /><Run FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SortArrowName, Mode=OneWay}" /></TextBlock>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SortHeader}" HorizontalAlignment="Center" CommandParameter="typologie" ToolTip="Trier par typologie">
                            <TextBlock Style="{StaticResource TextCaption}"><Run Text="Typologie" /><Run Text=" " /><Run FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SortArrowTypologie, Mode=OneWay}" /></TextBlock>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource SortHeader}" HorizontalAlignment="Center" CommandParameter="canton" ToolTip="Trier par canton">
                            <TextBlock Style="{StaticResource TextCaption}"><Run Text="Canton" /><Run Text=" " /><Run FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SortArrowCanton, Mode=OneWay}" /></TextBlock>
                        </Button>
                        <Button Grid.Column="4" Margin="8,0" Style="{StaticResource SortHeader}" HorizontalAlignment="Center" CommandParameter="donnees"
                                ToolTip="Trier par complétude : projets de référence d'abord, puis les plus complets">
                            <TextBlock Style="{StaticResource TextCaption}"><Run Text="Données du MDP" /><Run Text=" " /><Run FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SortArrowData, Mode=OneWay}" /></TextBlock>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding BenchmarkProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Clic : page du MDP (identité à remplir en priorité, ce qui manque, recharger) -->
                                    <Button Style="{StaticResource RowButton}" Padding="{StaticResource RowPadding}"
                                            Command="{Binding DataContext.OpenBaseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BaseFingerprint" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding Id}" />
                                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource TextBody}" Text="{Binding Name}" />
                                            <!-- Typologie : première dimension du benchmark ; « Non identifié » invite à cliquer -->
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Typologie}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIdentified}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TextMono}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding Canton}" />
                                            <!-- Empreinte de fiabilité : un segment par contrôle du moteur, toujours dans le même ordre -->
                                            <ItemsControl Grid.Column="4" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding Fingerprint}"
                                                          Focusable="False" AutomationProperties.Name="Empreinte de fiabilité">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{StaticResource FingerprintWidth}" Height="{StaticResource FingerprintHeight}"
                                                                Margin="{StaticResource FingerprintGap}" BorderThickness="1" CornerRadius="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <!-- Donnée manquante : contour seul, assez marqué pour se lire en clair comme en sombre -->
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BrushTextSecondary}" />
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ================================================================ PAGE D'UN MDP DE LA BASE : identité d'abord, puis ce qui manque -->
        <Grid Grid.Row="1" Visibility="{Binding IsBaseDetail, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <!-- Un point : glyphe, libellé, valeur ou détail, ce qu'il apporte au benchmark -->
                <DataTemplate x:Key="DetailPointTemplate" DataType="vm:DetailPoint">
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:VerdictGlyph VerticalAlignment="Center" Verdict="{Binding Verdict}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding Label}" />
                        <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Value}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{Binding Note}" />
                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            <Border Background="{DynamicResource BrushSurface}" Padding="16,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Open20}" Content="Ouvrir le MDP" MinHeight="{StaticResource TargetSize}"
                                   Command="{Binding OpenBaseMdpCommand}" ToolTip="Ouvrir le fichier dans Excel pour le compléter" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise20}" Content="Recharger"
                                   MinHeight="{StaticResource TargetSize}" Command="{Binding ReloadBaseDetailCommand}"
                                   ToolTip="Relire le MDP après l'avoir modifié" />
                    </StackPanel>
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft20}" Command="{Binding CloseBaseDetailCommand}"
                               ToolTip="Retour à l'accueil" AutomationProperties.Name="Retour"
                               MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextTitle}" Text="{Binding BaseDetail.Title}" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextCaption}" Text="{Binding BaseDetail.File}" />
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBenchmarkLoading, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource TextCaption}" Text="{Binding BenchmarkActivity}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Margin="24,16,24,24">
                    <!-- Entrée dans les références, ou la raison exacte de l'écart -->
                    <Border Margin="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushVerdictWarning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BaseDetail.IsReliable}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSeen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding BaseDetail.Status}" />
                    </Border>

                    <DockPanel Margin="0,28,0,8">
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Icon="{ui:SymbolIcon Edit20}" Content="Renseigner l'identité"
                                   MinHeight="{StaticResource TargetSize}"
                                   Command="{Binding EditBaseIdentityCommand}" CommandParameter="{Binding BaseDetail.Item}"
                                   ToolTip="Fiche Identité : écrite dans la feuille InfosProjet du MDP" />
                        <TextBlock VerticalAlignment="Center" Margin="0" Text="{Binding BaseDetail.IdentityHeader}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextSection}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BaseDetail.HasIdentityMissing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding BaseDetail.Identity}" ItemTemplate="{StaticResource DetailPointTemplate}" Focusable="False" />

                    <TextBlock Margin="0,28,0,8" Style="{StaticResource TextSection}" Text="{Binding BaseDetail.DataHeader}" />
                    <ItemsControl ItemsSource="{Binding BaseDetail.Data}" ItemTemplate="{StaticResource DetailPointTemplate}" Focusable="False" />
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Text="Les données se corrigent dans le MDP (Ouvrir le MDP), ou en réexportant le MDP depuis le projet de fiabilisation ; puis Recharger." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================ DASHBOARD (plan §Évolution 3.1) -->
        <Grid Grid.Row="1" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource BrushSurface}" Padding="16,8">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowClockwise20}"
                               MinHeight="{StaticResource TargetSize}" Command="{Binding RefreshBenchmarkCommand}"
                               ToolTip="Relire la base" AutomationProperties.Name="Relire la base" />
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft20}" Command="{Binding CloseDashboardCommand}"
                               ToolTip="{Binding CloseDashboardTooltip}" AutomationProperties.Name="Retour"
                               MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextTitle}" Text="Benchmark" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextCaption}" Text="{Binding BenchmarkSummary}" />
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBenchmarkLoading, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource TextCaption}" Text="{Binding BenchmarkActivity}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- La page dashboard/index.html ; données transmises par la vue (MainWindow.Dashboard.cs) -->
            <wv2:WebView2 x:Name="DashboardView" Grid.Row="1" DefaultBackgroundColor="Transparent" />
            <Border Grid.Row="1" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Banner}"
                    BorderBrush="{DynamicResource BrushVerdictError}"
                    Visibility="{Binding DashboardError, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding DashboardError}" />
            </Border>
        </Grid>

        <!-- ================================================================ ESPACE DE REVUE -->
        <Grid Grid.Row="1" Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barre de commande -->
            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" Padding="16,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise20}" Content="Régénérer"
                                   Command="{Binding RegenerateCommand}" MinHeight="{StaticResource TargetSize}"
                                   Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Régénérer les surfaces depuis la maquette IFC, décisions acceptées appliquées, puis analyser" />
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play20}" Content="{Binding AnalyseLabel}"
                                   Command="{Binding AnalyseCommand}" ToolTip="{Binding AnalyseTooltip}" MinHeight="{StaticResource TargetSize}"
                                   AutomationProperties.Name="Analyser" />
                        <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon Sparkle20}" Content="Revue IA"
                                   Command="{Binding OpenAiPanelCommand}" MinHeight="{StaticResource TargetSize}"
                                   ToolTip="Sur-vérification par IA : regroupe les points par cause et donne un verdict à chacun" />
                        <!-- Rouvre le dernier rapport sans relancer la revue (payante) -->
                        <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon DocumentText20}" Content="Rapport IA"
                                   Command="{Binding ShowAiReportCommand}" MinHeight="{StaticResource TargetSize}"
                                   ToolTip="Rouvrir le rapport de la dernière revue IA, sans la relancer (Ctrl+I)"
                                   Visibility="{Binding HasAiReport, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Exports sur les surfaces corrigées (journal joint) -->
                        <ui:DropDownButton Margin="8,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowExportUp20}" Content="Exporter"
                                           MinHeight="{StaticResource TargetSize}" AutomationProperties.Name="Exporter">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Rapports d'analyse…" Command="{Binding ExportCommand}"
                                              ToolTip="xlsx, html et json, avec le bilan des corrections appliquées" />
                                    <MenuItem Header="Tableau MDP…" Command="{Binding ExportMdpCommand}"
                                              ToolTip="Tableau MDP HRS rempli depuis le .tgm, gabarit vierge livré, surfaces corrigées" />
                                    <MenuItem Header="Tableau MDP à partir d'un gabarit…" Command="{Binding ExportMdpCommand}" CommandParameter="template"
                                              ToolTip="Choisir d'abord un MDP vierge ou déjà rempli : ses tableaux de surfaces sont remplacés" />
                                    <MenuItem Header="Exports Treegram…" Command="{Binding ExportTreegramCommand}"
                                              ToolTip="SurfacesNettes et SurfacesBrutes au gabarit Excel Treegram, surfaces corrigées" />
                                    <MenuItem Header="Excel de correction…" Command="{Binding ExportCorrectionsCommand}"
                                              ToolTip="Gabarit Treegram tel que lu, avec la catégorie et l'aire corrigées, la correction et son explication, et le journal" />
                                    <Separator />
                                    <MenuItem Header="Comparer au benchmark" Command="{Binding CompareToBenchmarkCommand}"
                                              ToolTip="Ouvre le dashboard sur ce projet (surfaces corrigées), comparé aux projets similaires de la base" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:Button Margin="8,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon DarkTheme20}"
                                   Command="{Binding ToggleThemeCommand}" ToolTip="Basculer thème sombre / clair"
                                   AutomationProperties.Name="Basculer le thème" MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                        <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Home20}"
                                   Command="{Binding GoHomeCommand}" ToolTip="Ouvrir un autre projet"
                                   AutomationProperties.Name="Accueil" MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clic sur le nom : fiche projet (identité, dossier) -->
                        <Button Style="{StaticResource RowButton}" Padding="0" VerticalAlignment="Center"
                                Command="{Binding EditProjectSheetCommand}" ToolTip="Fiche projet : identité HRS et dossier Treegram"
                                AutomationProperties.Name="Fiche projet">
                            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding ProjectName}" />
                        </Button>
                        <!-- Statut du projet (registre projets.json, lu par n8n) : un clic bascule en traitement / traité -->
                        <Button Style="{StaticResource RowButton}" Padding="0" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ToggleProjectStatusCommand}" ToolTip="{Binding ProjectStatusTooltip}"
                                AutomationProperties.Name="{Binding ProjectStatusLabel}">
                            <Border CornerRadius="10" BorderThickness="1" Padding="8,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushVerdictWarning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProjectDone}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSeen}" />
                                                <Setter Property="Background" Value="{DynamicResource BrushStatusSeen}" />
                                            </DataTrigger>
                                            <!-- Traité · modifié : contour seul, la publication est à refaire -->
                                            <DataTrigger Binding="{Binding IsProjectModified}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSeen}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="12">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ArrowSync16" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProjectDone}" Value="True">
                                                        <Setter Property="Symbol" Value="Checkmark16" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProjectModified}" Value="True">
                                                        <Setter Property="Symbol" Value="CloudArrowUp16" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushStatusSeen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Margin="4,0,0,0" FontSize="12" Text="{Binding ProjectStatusLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProjectDone}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProjectModified}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushStatusSeen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Style="{StaticResource TextCaption}" Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                   Text="{Binding ProjectDir}" ToolTip="{Binding ProjectDir}" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding AnalysedAt}" />
                        <!-- Corrections appliquées par la dernière analyse : lien vers l'onglet Sujets -->
                        <Button Style="{StaticResource RowButton}" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ShowAppliedCorrectionsCommand}" ToolTip="Voir les corrections appliquées (onglet Sujets)"
                                Visibility="{Binding HasAppliedCorrections, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}">
                                <Run Text="· " /><Run Text="{Binding AppliedText, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <!-- Dernière revue IA : lien vers son rapport -->
                        <Button Style="{StaticResource RowButton}" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ShowAiReportCommand}" ToolTip="{Binding AiReportTitle}"
                                Visibility="{Binding HasAiReview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="{Binding AiSummary}" />
                                <ui:SymbolIcon Margin="4,0,0,0" Symbol="Open16" Foreground="{DynamicResource BrushAccent}"
                                               Visibility="{Binding HasAiReport, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Border Margin="16,0,0,0" Style="{StaticResource Banner}" Padding="6,2" VerticalAlignment="Center"
                                Visibility="{Binding CacheIsStale, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding CacheWarning}">
                            <StackPanel Orientation="Horizontal">
                                <c:VerdictGlyph Verdict="ALERTE" />
                                <TextBlock Style="{StaticResource TextCaption}" Margin="6,0,0,0" Text="Cache 3D antérieur au projet" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Erreur d'analyse (les résultats précédents restent affichés) -->
            <ui:InfoBar Grid.Row="1" Severity="Error" IsClosable="True" Title="Analyse impossible"
                        Message="{Binding AnalysisError}"
                        IsOpen="{Binding HasAnalysisError, Mode=OneWay}"
                        Visibility="{Binding HasAnalysisError, Converter={StaticResource BoolToVisibility}}" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource LayersPanelWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="IssuesColumn" Width="380" MinWidth="{StaticResource IssuesPanelMinWidth}" />
                </Grid.ColumnDefinitions>

                <!-- ============ Panneau gauche : calques et filtres -->
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Marge droite : la barre de défilement ne recouvre pas les liens « Tout afficher » / « Tous » -->
                        <StackPanel Margin="0,0,10,0">
                            <DockPanel>
                                <!-- Tout afficher / tout masquer : deux icônes (œil, œil barré) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                                    <ui:Button Appearance="Transparent" Padding="4" Icon="{ui:SymbolIcon Eye20}"
                                               Command="{Binding ShowAllLayersCommand}" ToolTip="Afficher tous les calques"
                                               AutomationProperties.Name="Afficher tous les calques" />
                                    <ui:Button Margin="2,0,0,0" Appearance="Transparent" Padding="4" Icon="{ui:SymbolIcon EyeOff20}"
                                               Command="{Binding HideAllLayersCommand}" ToolTip="Masquer tous les calques"
                                               AutomationProperties.Name="Masquer tous les calques" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextSection}" Text="Calques" />
                            </DockPanel>
                            <ItemsControl x:Name="LayersList" ItemsSource="{Binding LayersView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,8,0,2" Text="{Binding Name}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:LayerItem">
                                        <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding HasGeometry}" MinHeight="28"
                                                  AutomationProperties.Name="{Binding Code}" HorizontalContentAlignment="Stretch"
                                                  ToolTipService.InitialShowDelay="300" ToolTipService.ShowOnDisabled="True">
                                            <CheckBox.ToolTip>
                                                <StackPanel MaxWidth="340">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" surfaces · " /><Run Text="{Binding Area, Converter={StaticResource Area}, Mode=OneWay}" /><Run Text=" m²" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0" Opacity="0.8" TextWrapping="Wrap" Text="{Binding Definition}"
                                                               Visibility="{Binding HasDefinition, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </CheckBox.ToolTip>
                                            <Grid Width="190">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="2" RadiusY="2"
                                                           Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextMono}" Text="{Binding Code}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" TextAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding Count, Converter={StaticResource Area}}" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                           Text="{Binding Area, Converter={StaticResource Area}}" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Projet généré : la maquette IFC en contexte (murs, dalles, toits, poteaux), masquée par défaut -->
                            <StackPanel Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,8,0,2" Text="Contexte" />
                                <CheckBox IsChecked="{Binding ShowIfcContext}" IsEnabled="{Binding HasIfcContext}" MinHeight="28"
                                          ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Maquette IFC"
                                          ToolTip="{Binding IfcContextTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" RadiusX="2" RadiusY="2"
                                                   Fill="{DynamicResource BrushTextSecondary}" Opacity="0.5" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource TextBody}" Text="Maquette IFC" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Padding="4,0" Margin="{StaticResource SectionGap}"
                                        Command="{Binding SelectAllBuildingsCommand}">
                                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Tous" />
                                </Button>
                                <TextBlock Style="{StaticResource TextSection}" Text="Bâtiments" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Buildings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:BuildingChip">
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource TextSection}" Text="Niveau" />
                            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" FontFamily="{StaticResource FontMono}" />

                            <TextBlock Style="{StaticResource TextSection}" Text="Éclater les niveaux" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Width="40" TextAlignment="Right"
                                           Text="{Binding Explode, StringFormat={}{0:0} m}" />
                                <Slider Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Explode}"
                                        AutomationProperties.Name="Écart entre niveaux" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ Centre : vue 3D + bilan par niveau -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <h:HelixViewport3D x:Name="Viewport" Grid.Row="0" Background="{DynamicResource BrushBackground}"
                                       ShowViewCube="True" ViewCubeHorizontalPosition="Right" ViewCubeVerticalPosition="Top"
                                       ViewCubeTopText="H" ViewCubeBottomText="B" ViewCubeFrontText="S" ViewCubeBackText="N"
                                       ViewCubeLeftText="O" ViewCubeRightText="E"
                                       ShowCoordinateSystem="False" IsHeadLightEnabled="False" ZoomExtentsWhenLoaded="False"
                                       CameraRotationMode="Turntable" ModelUpDirection="0,0,1" IsInertiaEnabled="False"
                                       ShowFrameRate="False" AutomationProperties.Name="Vue 3D des surfaces SIA">
                        <h:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="-120,-160,120" LookDirection="120,160,-120" UpDirection="0,0,1" FieldOfView="40" />
                        </h:HelixViewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <!-- Lumière surtout ambiante : les couleurs de la légende SIA doivent rester fidèles -->
                                    <AmbientLight Color="#C8C8C8" />
                                    <DirectionalLight Color="#3C3C3C" Direction="-0.3,-0.5,-1" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <ModelVisual3D x:Name="SceneVisual" />
                    </h:HelixViewport3D>

                    <!-- Bandeaux et états superposés à la 3D -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640">
                        <Border Style="{StaticResource Banner}" Visibility="{Binding MissingGeometryWarning, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding MissingGeometryWarning}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding NoLayerVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource TextSubtitle}" Text="Aucun calque visible" HorizontalAlignment="Center" />
                        <ui:Button Margin="0,8,0,0" Appearance="Secondary" Content="Tout afficher" HorizontalAlignment="Center"
                                   Command="{Binding ShowAllLayersCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TextSubtitle}"
                               Visibility="{Binding HasNoGeometry, Converter={StaticResource BoolToVisibility}}"
                               Text="Pas de cache 3D. Le contrôle chiffré reste disponible." />

                    <!-- Outils de vue -->
                    <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{StaticResource SpaceM}"
                            Background="{DynamicResource BrushSurface}" CornerRadius="{StaticResource RadiusControl}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ZoomFit20}" Content="Vue d'ensemble"
                                       Command="{Binding FrameAllCommand}" MinHeight="{StaticResource TargetSize}" />
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowDown20}" Content="Vue de dessus"
                                       Click="TopView_Click" ToolTip="T" MinHeight="{StaticResource TargetSize}" />
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon AddSquare20}" Content="Nouvelle surface"
                                       Command="{Binding OpenCreateSurfaceCommand}" MinHeight="{StaticResource TargetSize}"
                                       ToolTip="Tracer une surface manquante : bâtiment, niveau et type, puis son contour sur le plan" />
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" Content="Quitter l'isolement"
                                       Command="{Binding ClearFocusCommand}" ToolTip="Échap" MinHeight="{StaticResource TargetSize}"
                                       Visibility="{Binding IsFocused, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Fiche de la surface cliquée -->
                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource SpaceM}" Width="340"
                            Style="{StaticResource Card}" Visibility="{Binding HasSelectedSurface, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedSurface}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Padding="4"
                                           Click="CloseSurface_Click" AutomationProperties.Name="Fermer la fiche" />
                                <TextBlock Style="{StaticResource TextMono}" FontSize="{StaticResource FontSizeSubtitle}" Text="{Binding Title}" />
                            </DockPanel>
                            <TextBox Margin="0,4,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                                     Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding Surface.Id, Mode=OneWay}" TextWrapping="Wrap" />
                            <Border Margin="0,8,0,0" Style="{StaticResource Banner}" Padding="8,4"
                                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{Binding PendingText}" />
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Aire" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextBody}">
                                    <Run Text="{Binding Surface.Area, Converter={StaticResource Area}, Mode=OneWay}" /><Run Text=" m²" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Style="{StaticResource TextCaption}" Text="Nature" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBody}" Text="{Binding Kind}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource TextCaption}" Text="Sous-type" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBody}" Text="{Binding Surface.RoomType}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource TextCaption}" Text="Lot" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TextMono}" Text="{Binding Surface.Lot}" />
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Margin="0,0,4,4" Appearance="Secondary" Icon="{ui:SymbolIcon Edit20}" Content="Modifier…"
                                           Command="{Binding DataContext.OpenReshapeForSurfaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           MinHeight="{StaticResource TargetSize}"
                                           ToolTip="Changer le type, la nature, le sous-type ou le lot de la surface, ou redessiner son emprise sur le plan du niveau (sommets, arêtes)" />
                                <ui:Button Margin="0,0,4,4" Appearance="Secondary" Icon="{ui:SymbolIcon Cut20}" Content="Découper…"
                                           Command="{Binding DataContext.OpenTraceForSurfaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding CanCut, Converter={StaticResource BoolToVisibility}}"
                                           MinHeight="{StaticResource TargetSize}"
                                           ToolTip="Tracer sur le plan du niveau la part de cette surface qui change de catégorie" />
                                <ui:Button Margin="0,0,0,4" Appearance="Transparent" Icon="{ui:SymbolIcon Delete20}" Content="Supprimer"
                                           Command="{Binding DataContext.DeleteSelectedSurfaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           MinHeight="{StaticResource TargetSize}"
                                           ToolTip="Retirer cette surface des sommes et des exports (correction réversible)" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Points d'attention qui citent cette surface"
                                       Visibility="{Binding Issues.Count, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       Text="Aucun point d'attention ne cite cette surface."
                                       Visibility="{Binding HasNoIssue, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:IssueItem">
                                        <Button Style="{StaticResource RowButton}" Padding="4,2"
                                                Command="{Binding DataContext.SelectLinkedIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:VerdictGlyph Verdict="{Binding Verdict}" />
                                                <TextBlock Margin="6,0,0,0" Style="{StaticResource TextMono}" Text="{Binding Rule}" />
                                                <TextBlock Margin="8,0,0,0" Style="{StaticResource TextMono}" Text="{Binding Location}" />
                                                <TextBlock Margin="8,0,0,0" Style="{StaticResource TextCaption}" Text="{Binding Title}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ============ Bilan par niveau (élément signature) -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="12,6">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0"
                                              IsChecked="{Binding IsBalanceCollapsed}" AutomationProperties.Name="Replier le bilan"
                                              ToolTip="Replier / déplier le bilan">
                                    <ui:SymbolIcon Symbol="ChevronDown16" />
                                </ToggleButton>
                                <ComboBox DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="90" ItemsSource="{Binding BalanceChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BalanceBuilding}"
                                          FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Bâtiment du bilan" />
                                <Border DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource Banner}" Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsBalancePreview, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Bilan et ratios recalculés avec les corrections acceptées, avant l'analyse complète (Analyser recalcule aussi les tracés et les points)">
                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding BalancePreviewText}" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Deux onglets : bilan par niveau (signature) et ratios informatifs -->
                                    <RadioButton Style="{StaticResource Chip}" Margin="0,0,4,0" GroupName="BalanceTab"
                                                 IsChecked="{Binding ShowRatios, Converter={StaticResource Not}}"
                                                 ToolTip="Sommation SIA 416 niveau par niveau du bâtiment choisi">
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="Bilan par niveau" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" Margin="0,0,8,0" GroupName="BalanceTab" IsChecked="{Binding ShowRatios}"
                                                 ToolTip="Ratios informatifs SIA 416 / USPI du projet et du bâtiment choisi (repères indicatifs, non normatifs)">
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="Ratios" />
                                    </RadioButton>
                                    <TextBlock Style="{StaticResource TextSection}" Margin="0" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}"
                                               Text="{Binding BalanceScopeLabel, Mode=OneWay}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Height="{StaticResource BalanceHeight}" Visibility="{Binding IsBalanceCollapsed, Converter={StaticResource HiddenWhen}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,8"
                                          Visibility="{Binding ShowRatios, Converter={StaticResource HiddenWhen}}">
                                <ItemsControl ItemsSource="{Binding BalanceRows}" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:BalanceRow">
                                            <Button Style="{StaticResource RowButton}" Padding="4,1"
                                                    Command="{Binding DataContext.IsolateLevelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Level}">
                                                <Grid Height="{StaticResource BalanceRowHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BalanceStairs" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BalanceChange" /><!-- même largeur sur toutes les lignes : barres alignées -->
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource TextMono}" Text="{Binding Level}" VerticalAlignment="Center"
                                                               ToolTip="{Binding LevelTooltip}" />
                                                    <c:BalanceBar Grid.Column="1" Row="{Binding}"
                                                                  Palette="{Binding DataContext.Palette, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Outline="{DynamicResource BrushTextSecondary}" Error="{DynamicResource BrushVerdictError}" />
                                                    <c:VerdictGlyph Grid.Column="2" Margin="4,0,0,0" Verdict="{Binding R1Verdict}"
                                                                    Visibility="{Binding ShowR1Glyph, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                               Visibility="{Binding HasFloor, Converter={StaticResource BoolToVisibility}}"
                                                               Text="{Binding R1Diff, Converter={StaticResource Area}}" />
                                                    <!-- Façade du niveau (Évolution 3.6) : vitrages puis partie pleine, sur l'échelle des façades -->
                                                    <Grid Grid.Column="4" Margin="12,0,0,0" Background="Transparent" ToolTip="{Binding FacadeTooltip}"
                                                          ToolTipService.ShowDuration="30000"
                                                          Visibility="{Binding HasFacade, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                                                        </Grid.ColumnDefinitions>
                                                        <c:FacadeBar Row="{Binding}"
                                                                     Palette="{Binding DataContext.Palette, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding GlazingShareText}" />
                                                    </Grid>
                                                    <!-- Cages d'escalier de l'étage de logements (V3.1) : nombre, SUP et logements par cage -->
                                                    <StackPanel Grid.Column="5" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Background="Transparent" ToolTip="{Binding StairsTooltip}" ToolTipService.ShowDuration="30000"
                                                                Visibility="{Binding IsHousing, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock x:Name="StairsCount" Style="{StaticResource TextCaption}" MinWidth="64" Text="{Binding StairsText}" />
                                                        <TextBlock Style="{StaticResource TextNumber}" MinWidth="110" Foreground="{DynamicResource BrushTextSecondary}"
                                                                   Text="{Binding StairsRatioText}" />
                                                    </StackPanel>
                                                    <!-- Avant / après : ancien résidu barré, nouveau avec son verdict -->
                                                    <StackPanel Grid.Column="6" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                                ToolTip="{Binding ChangeTooltip}"
                                                                Visibility="{Binding HasChange, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource TextNumber}" Foreground="{DynamicResource BrushTextSecondary}"
                                                                   TextDecorations="Strikethrough" Text="{Binding ChangeBefore}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Margin="6,0" Text="→" />
                                                        <c:VerdictGlyph Verdict="{Binding ChangeVerdict}" />
                                                        <TextBlock Style="{StaticResource TextNumber}" Margin="4,0,0,0" Text="{Binding ChangeAfter}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="7" Margin="8,0,0,0" Style="{StaticResource TextMono}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrushVerdictWarning}" Text="{Binding Alerts}" />
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasNoStair}" Value="True">
                                                    <Setter TargetName="StairsCount" Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- ============ Ratios informatifs : projet (cercle) et bâtiment (point) sur le repère indicatif -->
                            <DockPanel Visibility="{Binding ShowRatios, Converter={StaticResource BoolToVisibility}}" Margin="12,0,12,8">
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="72" /><ColumnDefinition Width="72" /><ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Ratio" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" Text="Libellé" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="○ projet   ● bâtiment" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}" Text="Projet" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}"
                                               Text="{Binding BalanceScopeLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource TextCaption}" Text="Repère" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Margin="4,8" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Visibility="{Binding HasRatios, Converter={StaticResource HiddenWhen}}"
                                           Text="Pas de ratios dans cette analyse : relancez « Analyser » pour les calculer." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RatioRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:RatioRow">
                                                <Grid Height="{StaticResource BalanceRowHeight}" Margin="4,0,18,0" Background="Transparent" ToolTip="{Binding Tooltip}"
                                                      ToolTipService.ShowDuration="30000" AutomationProperties.Name="{Binding Label}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="72" /><ColumnDefinition Width="72" /><ColumnDefinition Width="112" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding Id}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                                    <c:RatioGauge Grid.Column="2" Margin="8,0" Row="{Binding}" Track="{DynamicResource BrushTextSecondary}"
                                                                  Accent="{DynamicResource BrushAccent}" Warning="{DynamicResource BrushVerdictWarning}" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding ProjectText}" />
                                                    <TextBlock x:Name="Bld" Grid.Column="4" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                               Text="{Binding BuildingText}" />
                                                    <TextBlock Grid.Column="5" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding ReferenceText}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutside}" Value="True">
                                                        <Setter TargetName="Bld" Property="Foreground" Value="{DynamicResource BrushVerdictWarning}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ============ Rapport de revue IA : volet sur la 3D, la liste reste cliquable -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Margin="{StaticResource SpaceM}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                            Visibility="{Binding IsAiReportOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="16,8,8,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Open20}" Content="Ouvrir le fichier"
                                                   Command="{Binding OpenAiReportFileCommand}" MinHeight="{StaticResource TargetSize}" />
                                        <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}"
                                                   Command="{Binding CloseAiReportCommand}" ToolTip="Fermer le rapport (Échap)"
                                                   AutomationProperties.Name="Fermer le rapport" MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextSection}" Margin="0" VerticalAlignment="Center" Text="{Binding AiReportTitle}" />
                                </DockPanel>
                            </Border>
                            <c:MarkdownViewer Markdown="{Binding AiReportMarkdown}" AutomationProperties.Name="Rapport de revue IA" />
                        </DockPanel>
                    </Border>

                    <!-- ============ Module de tracé (Évolution 2.1) : volet sur la 3D et le bilan, panneau Sujets actif -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Margin="{StaticResource SpaceM}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                            Visibility="{Binding IsTraceOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="16,8,8,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent" Content="Annuler" Command="{Binding CancelTraceCommand}" MinHeight="{StaticResource TargetSize}" />
                                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Save20}" Content="Enregistrer"
                                                   Command="{Binding SaveTraceCommand}" IsEnabled="{Binding Trace.CanSave}" MinHeight="{StaticResource TargetSize}" />
                                        <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" Command="{Binding CancelTraceCommand}"
                                                   ToolTip="Fermer le tracé (Échap)" AutomationProperties.Name="Fermer le tracé"
                                                   MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0" VerticalAlignment="Center">
                                            <Run Text="Tracé · " /><Run Text="{Binding TraceTitle, Mode=OneWay}" FontFamily="{StaticResource FontMono}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTraceCreate, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox Margin="12,0,0,0" MinWidth="72" ItemsSource="{Binding TraceBuildings}" SelectedItem="{Binding TraceBuilding}"
                                                      FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Bâtiment de la nouvelle surface"
                                                      ToolTip="Bâtiment" />
                                            <ComboBox Margin="4,0,0,0" MinWidth="72" ItemsSource="{Binding TraceLevels}" SelectedItem="{Binding TraceLevel}"
                                                      FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Niveau de la nouvelle surface"
                                                      ToolTip="Niveau : le plan montre ses surfaces existantes" />
                                        </StackPanel>
                                        <ComboBox Margin="8,0,0,0" MinWidth="80" ItemsSource="{Binding TraceTargets}" SelectedItem="{Binding TraceTarget}"
                                                  FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Catégorie"
                                                  ToolTip="Type SIA 416 de la surface (ou de la part découpée)"
                                                  Visibility="{Binding ShowTraceTargets, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Barre d'outils -->
                            <Border DockPanel.Dock="Top" Padding="12,6" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrushBackground}" CornerRadius="{StaticResource RadiusControl}" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="TraceMode" Content="Tracer" IsChecked="{Binding Trace.IsDrawMode}"
                                                         ToolTip="Ajouter des points ; Entrée ou double-clic ferme le polygone" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="TraceMode" Content="Modifier" IsChecked="{Binding Trace.IsEditMode}"
                                                         ToolTip="Déplacer, ajouter ou retirer des sommets" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="TraceMode" Content="Scinder" IsChecked="{Binding Trace.IsSplitMode}"
                                                         Visibility="{Binding Trace.IsReshape, Converter={StaticResource BoolToVisibility}}"
                                                         ToolTip="SPLIT : tracer une ligne qui coupe la surface en deux surfaces, chacune avec son type" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="16,0,6,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Accrochage" />
                                    <ToggleButton Style="{StaticResource Chip}" FontFamily="{StaticResource FontUI}" Content="Sommets" IsChecked="{Binding Trace.SnapToVertices}"
                                                  ToolTip="Accrocher aux sommets des surfaces (Alt : sans accrochage pour ce clic)" />
                                    <ToggleButton Style="{StaticResource Chip}" FontFamily="{StaticResource FontUI}" Content="Arêtes" IsChecked="{Binding Trace.SnapToEdges}"
                                                  ToolTip="Accrocher aux arêtes des surfaces et de l'emprise du niveau inférieur" />
                                    <ToggleButton Style="{StaticResource Chip}" FontFamily="{StaticResource FontUI}" Content="Angles droits" IsChecked="{Binding Trace.SnapToRightAngles}"
                                                  ToolTip="Accrochage léger à l'équerre des arêtes voisines du tracé, avec un repère à l'angle (Alt : sans accrochage)" />
                                    <ToggleButton Margin="16,0,0,0" Style="{StaticResource Chip}" FontFamily="{StaticResource FontUI}" Content="Autres surfaces en transparence"
                                                  IsChecked="{Binding Trace.FadeOthers}"
                                                  ToolTip="Ne garder que le contour des autres surfaces du niveau, pour bien voir le tracé" />
                                    <ui:Button Margin="16,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUndo20}" Content="Annuler le geste"
                                               Command="{Binding TraceUndoCommand}" ToolTip="Ctrl+Z (Ctrl+Y : rétablir)" MinHeight="{StaticResource TargetSize}" />
                                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Eraser20}" Content="Effacer"
                                               Command="{Binding TraceClearCommand}" ToolTip="Effacer tout le tracé" MinHeight="{StaticResource TargetSize}" />
                                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ZoomFit20}" Content="Cadrer"
                                               Command="{Binding TraceFitCommand}" ToolTip="F" MinHeight="{StaticResource TargetSize}" />
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Margin="12,6" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{Binding Trace.Help}" />
                            <!-- Chiffres : aire comptée, décomposition, écart R3 du niveau -->
                            <Border DockPanel.Dock="Right" Width="248" Padding="16,12" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1,0,0,0">
                                <StackPanel>
                                    <!-- Scinder : les deux parties, leur type et leur aire -->
                                    <StackPanel Margin="0,0,0,16" Visibility="{Binding Trace.IsSplitMode, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,4" Text="Scinder la surface" />
                                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                                   Visibility="{Binding Trace.IsSplitDone, Converter={StaticResource HiddenWhen}}"
                                                   Text="Tracez une ligne qui traverse la surface, puis Entrée ou double-clic." />
                                        <Grid Visibility="{Binding Trace.IsSplitDone, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="1" />
                                            <ComboBox Grid.Column="1" Margin="8,2" ItemsSource="{x:Static vm:MainViewModel.SurfaceTypes}" SelectedItem="{Binding Trace.SplitTypeA}"
                                                      FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Type de la partie 1"
                                                      ToolTip="Partie 1 : la plus grande, elle garde la surface d'origine" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding Trace.SplitAreaAText}" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="2" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,2" ItemsSource="{x:Static vm:MainViewModel.SurfaceTypes}" SelectedItem="{Binding Trace.SplitTypeB}"
                                                      FontFamily="{StaticResource FontMono}" AutomationProperties.Name="Type de la partie 2"
                                                      ToolTip="Partie 2 : nouvelle surface, mêmes bâtiment, niveau, lot et sous-type" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding Trace.SplitAreaBText}" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushVerdictError}" TextWrapping="Wrap"
                                                   Text="{Binding Trace.SplitMessage}" />
                                    </StackPanel>
                                    <!-- Métadonnées de la surface (V3.1) : nature, sous-type, lot ; le type SIA se choisit dans l'en-tête -->
                                    <StackPanel Margin="0,0,0,16" Visibility="{Binding Trace.CanEditMetadata, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,4" Text="Métadonnées" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Nature" />
                                            <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{x:Static vm:TraceSession.Natures}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Trace.Nature}" AutomationProperties.Name="Nature de la surface"
                                                      ToolTip="Surface élémentaire (une pièce) ou total de niveau Treegram. Un total de niveau ne compte que si sa catégorie n'a pas de surfaces élémentaires au niveau." />
                                            <TextBlock Grid.Row="1" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Sous-type" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsEditable="True" ItemsSource="{Binding TraceSubTypes}"
                                                      Text="{Binding Trace.SubType, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sous-type de la surface"
                                                      ToolTip="Type de pièce Treegram (Escalier, CirculationH, PieceDeVie…) : les cages d'escalier sont les SD de sous-type Escalier" />
                                            <TextBlock Grid.Row="2" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Lot" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEditable="True" ItemsSource="{Binding TraceLots}"
                                                      FontFamily="{StaticResource FontMono}"
                                                      Text="{Binding Trace.Lot, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lot de la surface"
                                                      ToolTip="Logement (appartement) de la surface ; vide pour une partie commune" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                                   Visibility="{Binding Trace.IsMetadataOnly, Converter={StaticResource BoolToVisibility}}"
                                                   Text="Métadonnées seules : l'emprise et l'aire lues restent inchangées." />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,4" Text="Aire du tracé" />
                                    <TextBlock Style="{StaticResource TextNumber}" FontSize="{StaticResource FontSizeTitle}" FontFamily="{StaticResource FontUISemibold}"
                                               HorizontalAlignment="Left" Text="{Binding Trace.CountedText}" />
                                    <Grid Margin="0,12,0,0" Visibility="{Binding Trace.IsReshape, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource TextCaption}" Text="avant modification" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Trace.OriginalAreaText}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource TextCaption}" Text="écart" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Trace.AreaDeltaText}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0" Visibility="{Binding Trace.IsCut, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Trace.SourceLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Trace.OnSourceText}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource TextCaption}" Text="retiré : SEU / SED / SEI"
                                                   Visibility="{Binding Trace.HasClassified, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Trace.RemovedText}"
                                                   Visibility="{Binding Trace.HasClassified, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource TextCaption}" Text="{Binding Trace.OutsideLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Trace.OutsideText}" />
                                    </Grid>
                                    <Border Margin="0,12,0,0" Style="{StaticResource Banner}" Padding="8,4"
                                            Visibility="{Binding Trace.HasMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="TraceMessage" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{Binding Trace.Message}" />
                                    </Border>
                                    <StackPanel Visibility="{Binding Trace.IsCut, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource TextSection}" Margin="0,20,0,4" Text="Écart R3 du niveau" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextNumber}" Foreground="{DynamicResource BrushTextSecondary}" TextDecorations="Strikethrough"
                                                   Text="{Binding Trace.R3BeforeText}" />
                                        <TextBlock Margin="6,0" Style="{StaticResource TextCaption}" Text="→" />
                                        <c:VerdictGlyph Verdict="{Binding Trace.R3Verdict}" />
                                        <TextBlock Margin="4,0,0,0" Style="{StaticResource TextNumber}" Text="{Binding Trace.R3AfterText}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                               Text="si la correction est acceptée et appliquée (Analyser)" />
                                    </StackPanel>
                                    <TextBlock Margin="0,20,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                               Visibility="{Binding Trace.IsCut, Converter={StaticResource HiddenWhen}}"
                                               Text="Enregistrer ajoute une correction acceptée à « Corrections manuelles » ; elle s'applique à la prochaine analyse (Analyser)." />
                                </StackPanel>
                            </Border>
                            <c:TracePlan x:Name="TracePlanControl" Session="{Binding Trace}"
                                         Palette="{Binding Palette}" Accent="{DynamicResource BrushAccent}" Primary="{DynamicResource BrushTextPrimary}"
                                         Secondary="{DynamicResource BrushTextSecondary}" Error="{DynamicResource BrushVerdictError}"
                                         AutomationProperties.Name="Plan du niveau pour le tracé" />
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="2" Width="4" Background="{DynamicResource BrushDivider}" ResizeDirection="Columns"
                              HorizontalAlignment="Stretch" ShowsPreview="False" DragCompleted="Splitter_DragCompleted" />

                <!-- ============ Panneau droit : onglets Sujets (Évolution 2.0) et Points d'attention -->
                <Border Grid.Column="3" Style="{StaticResource Panel}">
                    <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Chip}" Margin="0,0,4,0" GroupName="RightTab" IsChecked="{Binding ShowSubjects}"
                                     ToolTip="Sujets et corrections proposées (Ctrl+1)" AutomationProperties.Name="Onglet Sujets"
                                     Visibility="{Binding HasSubjects, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Run Text="Sujets" /><Run Text="  " /><Run Text="{Binding Subjects.Count, Mode=OneWay}" />
                            </TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" Margin="0" GroupName="RightTab" IsChecked="{Binding ShowPoints, Mode=OneWay}"
                                     Command="{Binding ShowPointsTabCommand}"
                                     ToolTip="Points d'attention de l'analyse (Ctrl+2)" AutomationProperties.Name="Onglet Points d'attention">
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Run Text="Points d'attention" /><Run Text="  " /><Run Text="{Binding Issues.Count, Mode=OneWay}" />
                            </TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" Margin="4,0,0,0" GroupName="RightTab" IsChecked="{Binding ShowSpaces, Mode=OneWay}"
                                     Command="{Binding ShowSpacesTabCommand}"
                                     ToolTip="Espaces de la maquette, décisions de classement et analyse IA (Ctrl+3)" AutomationProperties.Name="Onglet Espaces"
                                     Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TextSection}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Run Text="Espaces" /><Run Text="  " /><Run Text="{Binding Spaces.Count, Mode=OneWay}" />
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                    <Grid>
                    <!-- ===== Onglet Espaces (Évolution 4.0) -->
                    <c:SpacesPanel Visibility="{Binding ShowSpaces, Converter={StaticResource BoolToVisibility}}" />
                    <!-- ===== Onglet Sujets -->
                    <DockPanel Visibility="{Binding ShowSubjects, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top">
                            <Border Style="{StaticResource Banner}" Margin="0,0,0,8" Padding="8,4" ToolTip="{Binding ReviewProblemsDetail}"
                                    Visibility="{Binding HasReviewProblems, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Padding="4,0" Command="{Binding ShowReviewProblemsCommand}">
                                        <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Voir" />
                                    </Button>
                                    <c:VerdictGlyph Verdict="ALERTE" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="{Binding ReviewProblemsText}" />
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding CorrectionsSummary}" />
                                <ComboBox ItemsSource="{Binding SubjectChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SubjectFilter}" AutomationProperties.Name="Filtrer les sujets" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Carte Sujet -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                                Visibility="{Binding HasSelectedSubject, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel DataContext="{Binding SelectedSubject}">
                                    <ui:Button DockPanel.Dock="Left" Margin="-4,-2,6,0" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                                               VerticalAlignment="Top" Command="{Binding DataContext.CloseSubjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ToolTip="Fermer le sujet (ou cliquer à nouveau sur le sujet)" AutomationProperties.Name="Fermer le sujet" />
                                    <c:AiVerdictTag DockPanel.Dock="Right" Margin="8,0,0,0" Kind="{Binding ActionKind}" Text="{Binding OriginTag}" />
                                    <TextBlock Style="{StaticResource TextSubtitle}" TextWrapping="Wrap">
                                        <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource FontMono}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding SelectedSubject.Explanation}"
                                           Visibility="{Binding SelectedSubject.HasExplanation, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Text="Pas de correction automatique : à vérifier dans Treegram."
                                           Visibility="{Binding SelectedSubject.HasCorrections, Converter={StaticResource HiddenWhen}}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap">
                                    <Run Text="Points : " /><Run Text="{Binding SelectedSubject.PointsState, Mode=OneWay}" />
                                </TextBlock>
                                <!-- Les points du sujet : clic = le point dans l'onglet Points, isolé en 3D -->
                                <ScrollViewer Margin="0,4,0,0" MaxHeight="168" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedSubjectPoints, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding SelectedSubjectPoints}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:IssueItem">
                                                <Button Style="{StaticResource RowButton}" Padding="4,2" ToolTip="{Binding Tooltip}"
                                                        Command="{Binding DataContext.OpenSubjectPointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="104" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <c:VerdictGlyph VerticalAlignment="Center" Verdict="{Binding Verdict}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Location}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        <TextBlock Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                                   Text="{Binding DiffM2, Converter={StaticResource Area}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedSubject.HasCorrections}" Value="False" />
                                                        <Condition Binding="{Binding SelectedSubject.HasOpenPoints}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Eye20}" MinHeight="{StaticResource TargetSize}"
                                               Content="{Binding SelectedSubject.SeenAllLabel}" Command="{Binding MarkSubjectPointsSeenCommand}"
                                               ToolTip="Passe en « Vu » les points « À traiter » de ce sujet (un commentaire rappelle le sujet)" />
                                    <ui:Button Margin="8,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" MinHeight="{StaticResource TargetSize}"
                                               Content="{Binding SelectedSubject.FalseAllLabel}" Command="{Binding MarkSubjectPointsFalseCommand}"
                                               ToolTip="Passe en « Faux positif » les points « À traiter » de ce sujet (réversible point par point : 1 dans l'onglet Points)" />
                                </StackPanel>
                                <Button Margin="0,2,0,0" HorizontalAlignment="Right" Style="{StaticResource RowButton}" Padding="4,0"
                                        Command="{Binding ShowAiReportCommand}"
                                        Visibility="{Binding SelectedSubject.IsAi, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Voir le rapport ↗" />
                                </Button>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding SelectedSubject.CanDecide, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Checkmark20}" MinHeight="{StaticResource TargetSize}"
                                                   Content="{Binding SelectedSubject.AcceptAllLabel}" Command="{Binding AcceptAllCorrectionsCommand}"
                                                   ToolTip="Accepte toutes les corrections du sujet ; elles s'appliquent à la prochaine analyse" />
                                        <ui:Button Margin="8,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" MinHeight="{StaticResource TargetSize}"
                                                   Content="{Binding SelectedSubject.RejectAllLabel}" Command="{Binding RejectAllCorrectionsCommand}"
                                                   ToolTip="Rejette toutes les corrections du sujet (réversible : 1 repasse une correction en « proposée »)" />
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Visibility="{Binding SelectedSubject.HasCorrections, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource TextSection}" Margin="0,12,0,4" Text="Corrections" />
                                    <ListBox x:Name="CorrectionsList" ItemsSource="{Binding SelectedSubject.Corrections}" SelectedItem="{Binding SelectedCorrection}"
                                             ItemContainerStyle="{StaticResource IssueItem}" Background="Transparent" BorderThickness="0" MaxHeight="232"
                                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewKeyDown="CorrectionsList_PreviewKeyDown" AutomationProperties.Name="Corrections du sujet">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:CorrectionItem">
                                                <Grid ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="600">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <c:CorrectionGlyph State="{Binding State}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding Model.Op}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding Location}" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="Sum" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                                                        <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSiaSA}"
                                                                Visibility="{Binding IsToAbords, Converter={StaticResource BoolToVisibility}}" ToolTip="Abords SA (SIA 416 §1.2)">
                                                            <TextBlock Style="{StaticResource TextMono}" Foreground="{DynamicResource BrushOnAccent}" Text="SA" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Area" Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding AreaText}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                        <Setter TargetName="Sum" Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter TargetName="Area" Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter TargetName="Area" Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Correction sélectionnée -->
                                <StackPanel Margin="0,8,0,0" DataContext="{Binding SelectedCorrection}"
                                            Visibility="{Binding DataContext.HasSelectedCorrection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                    <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" VerticalAlignment="Center">
                                            <Run Text="origine : " /><Run Text="{Binding OriginLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center">
                                            <Run Text="{Binding Location, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding Explanation}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <c:CorrectionGlyph State="{Binding State}" Size="14" />
                                        <TextBlock Margin="6,0,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{Binding StateLabel}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource TextCaption}" Text="Aire estimée, sans tracé."
                                               Visibility="{Binding HasNoTrace, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource HiddenWhen}}">
                                        <!-- Ce qu'est la part visée (SEP / SP non classée) : choisir, puis accepter -->
                                        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasDestinations, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Left" Width="80" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Classer en" />
                                            <ComboBox ItemsSource="{Binding Destinations}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Destination}" AutomationProperties.Name="Catégorie de la part visée"
                                                      ToolTip="Catégorie SIA 416 de cette part de surface ; la correction devient « manuel »" />
                                        </DockPanel>
                                        <Border Background="{DynamicResource BrushBackground}" CornerRadius="{StaticResource RadiusControl}" Padding="2">
                                            <UniformGrid Rows="1">
                                                <RadioButton Style="{StaticResource Segment}" GroupName="Decision" Content="Proposée" ToolTip="1"
                                                             IsChecked="{Binding Decision, Converter={StaticResource EqualsTo}, ConverterParameter=Proposed}" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="Decision" Content="Acceptée" ToolTip="2"
                                                             IsChecked="{Binding Decision, Converter={StaticResource EqualsTo}, ConverterParameter=Accepted}" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="Decision" Content="{Binding RejectLabel}" ToolTip="3"
                                                             IsChecked="{Binding Decision, Converter={StaticResource EqualsTo}, ConverterParameter=Rejected}" />
                                            </UniformGrid>
                                        </Border>
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Margin="0" Appearance="Transparent" Icon="{ui:SymbolIcon Pen20}" Content="Tracer…"
                                                       Command="{Binding DataContext.OpenTraceForCorrectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Visibility="{Binding CanTrace, Converter={StaticResource BoolToVisibility}}"
                                                       MinHeight="{StaticResource TargetSize}" ToolTip="Dessiner ou ajuster la part de surface sur le plan du niveau (T)" />
                                            <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon Edit20}" Content="Modifier"
                                                       Command="{Binding DataContext.EditCorrectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       MinHeight="{StaticResource TargetSize}" ToolTip="Modifier l'aire ou l'explication (la correction devient « manuel »)" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Édition en place : Entrée valide, Échap annule -->
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                PreviewKeyDown="CorrectionEdit_PreviewKeyDown">
                                        <DockPanel Visibility="{Binding CanEditArea, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="m²" />
                                            <TextBlock DockPanel.Dock="Left" Width="80" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="Aire" />
                                            <ui:TextBox x:Name="EditAreaBox" Text="{Binding EditArea, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Aire de la correction" />
                                        </DockPanel>
                                        <TextBlock Margin="80,2,0,0" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushVerdictError}" TextWrapping="Wrap"
                                                   Text="{Binding EditError}" Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}" />
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Width="80" Style="{StaticResource TextCaption}" VerticalAlignment="Top" Margin="0,6,0,0" Text="Explication" />
                                            <ui:TextBox Text="{Binding EditExplanation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="48" MaxHeight="96"
                                                        AutomationProperties.Name="Explication de la correction" />
                                        </DockPanel>
                                        <TextBlock Margin="80,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                                   Text="L'origine passe à « manuel » ; la proposition d'origine est gardée dans le journal." />
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Appearance="Transparent" Content="Annuler" MinHeight="{StaticResource TargetSize}"
                                                       Command="{Binding DataContext.CancelCorrectionEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <ui:Button Margin="8,0,0,0" Appearance="Secondary" Content="Enregistrer" MinHeight="{StaticResource TargetSize}"
                                                       Command="{Binding DataContext.CommitCorrectionEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ListBox x:Name="SubjectsList" ItemsSource="{Binding SubjectsView}" SelectedItem="{Binding SelectedSubject}"
                                     PreviewMouseLeftButtonDown="SubjectsList_PreviewMouseDown"
                                     ItemContainerStyle="{StaticResource IssueItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sujets">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:SubjectItem">
                                        <Grid ToolTip="{Binding Explanation}" ToolTipService.InitialShowDelay="800">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource TextMono}" VerticalAlignment="Center" Text="{Binding ShortId}" />
                                            <TextBlock x:Name="Title" Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding M2Text}" />
                                            <StackPanel x:Name="Tags" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3,0,0">
                                                <c:AiVerdictTag Kind="{Binding ActionKind}" Text="{Binding Action}" />
                                                <c:AiVerdictTag Margin="4,0,0,0" Kind="Unknown" Text="{Binding OriginLabel}" />
                                                <TextBlock Margin="8,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Text="{Binding Counts}" />
                                            </StackPanel>
                                            <DockPanel x:Name="Frise" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                                                       Visibility="{Binding HasCorrections, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource TextNumber}" VerticalAlignment="Center" Text="{Binding Progress}" />
                                                <ItemsControl ItemsSource="{Binding Corrections}" Focusable="False"
                                                              Visibility="{Binding ShowGlyphs, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:CorrectionItem">
                                                            <c:CorrectionGlyph State="{Binding State}" Size="12" Margin="0,0,1,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- Sujet du moteur, sans repère court : le titre prend la colonne du repère -->
                                            <DataTrigger Binding="{Binding HasShortId}" Value="False">
                                                <Setter TargetName="Title" Property="Grid.Column" Value="0" />
                                                <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="2" />
                                                <Setter TargetName="Tags" Property="Grid.Column" Value="0" />
                                                <Setter TargetName="Tags" Property="Grid.ColumnSpan" Value="3" />
                                                <Setter TargetName="Frise" Property="Grid.Column" Value="0" />
                                                <Setter TargetName="Frise" Property="Grid.ColumnSpan" Value="3" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="4,16,0,4" Text="{Binding Name}"
                                                           ToolTip="Champs à remplir dans le tableau MDP : pas des problèmes de surfaces, donc sans points">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextSection}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding SubjectsEmptyMessage, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource TextBody}" HorizontalAlignment="Center" Text="{Binding SubjectsEmptyMessage}" />
                                <Button Style="{StaticResource RowButton}" Padding="4,2" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Command="{Binding ResetSubjectFilterCommand}">
                                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Tout afficher" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- ===== Onglet Points d'attention -->
                    <DockPanel Visibility="{Binding ShowPoints, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource VerdictToggle}" IsChecked="{Binding ShowErrors}" AutomationProperties.Name="Erreurs">
                                    <StackPanel Orientation="Horizontal"><c:VerdictGlyph Verdict="ERREUR" /><TextBlock Margin="6,0,0,0" Text="{Binding ErrorCount}" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource VerdictToggle}" IsChecked="{Binding ShowWarnings}" AutomationProperties.Name="Alertes">
                                    <StackPanel Orientation="Horizontal"><c:VerdictGlyph Verdict="ALERTE" /><TextBlock Margin="6,0,0,0" Text="{Binding WarningCount}" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource VerdictToggle}" IsChecked="{Binding ShowInfos}" AutomationProperties.Name="Informations">
                                    <StackPanel Orientation="Horizontal"><c:VerdictGlyph Verdict="INFO" /><TextBlock Margin="6,0,0,0" Text="{Binding InfoCount}" /></StackPanel>
                                </ToggleButton>
                            </WrapPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Rules}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding RuleFilter}" AutomationProperties.Name="Filtrer par règle" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding StatusFilter}" AutomationProperties.Name="Filtrer par statut" />
                            </Grid>
                            <!-- Revue IA chargée : filtre par verdict IA et application des faux positifs -->
                            <Grid Margin="0,0,0,8" Visibility="{Binding HasAiReview, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AiChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding AiFilter}" AutomationProperties.Name="Filtrer par verdict IA" />
                                <ui:Button Grid.Column="2" Appearance="Secondary" HorizontalAlignment="Stretch" MinHeight="{StaticResource TargetSize}"
                                           Command="{Binding ApplyAiFalsePositivesCommand}"
                                           ToolTip="Passe en « Faux positif » les points « À traiter » que l'IA juge faux positifs ; la raison de l'IA devient le commentaire">
                                    <TextBlock>
                                        <Run Text="Appliquer les faux positifs (" /><Run Text="{Binding AiFalsePositiveCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </ui:Button>
                            </Grid>
                        </StackPanel>

                        <!-- Détail du point sélectionné -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                                Visibility="{Binding HasSelectedIssue, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DataContext="{Binding SelectedIssue}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Margin="-4,-2,6,0" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                                               VerticalAlignment="Top" Command="{Binding DataContext.CloseIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ToolTip="Fermer le point (ou cliquer à nouveau sur le point)" AutomationProperties.Name="Fermer le point" />
                                    <c:VerdictGlyph Verdict="{Binding Verdict}" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource TextMono}" FontSize="{StaticResource FontSizeSubtitle}">
                                        <Run Text="{Binding Rule, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Location, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextSubtitle}" TextWrapping="Wrap" Text="{Binding Title}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding Message}" />
                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushBackground}"
                                        Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,2" Text="À vérifier" />
                                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushBackground}"
                                        Visibility="{Binding HasAi, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Padding="4,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ShowAiReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding DataContext.HasAiReport, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Voir le rapport ↗" />
                                            </Button>
                                            <TextBlock Style="{StaticResource TextSection}" Margin="0,0,8,0" VerticalAlignment="Center" Text="Revue IA" />
                                            <c:AiVerdictTag Kind="{Binding AiKind}" Text="{Binding AiTag}" HorizontalAlignment="Left" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding AiReason}" />
                                        <Button Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource RowButton}" Padding="4,0"
                                                Command="{Binding DataContext.ShowSubjectOfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasSubjectLink, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Voir le sujet et ses corrections" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,8,0,0" Visibility="{Binding IsResolved, Converter={StaticResource HiddenWhen}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="attendu" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Expected, Converter={StaticResource Area}}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource TextCaption}" Text="obtenu" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextNumber}" Text="{Binding Obtained, Converter={StaticResource Area}}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource TextCaption}" Text="écart" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextNumber}" FontFamily="{StaticResource FontUISemibold}"
                                               Text="{Binding DiffM2, Converter={StaticResource Area}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource TextCaption}"
                                               Text="{Binding DiffPct, Converter={StaticResource Area}, ConverterParameter=pct}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextCaption}"
                                           Visibility="{Binding IsResolved, Converter={StaticResource HiddenWhen}}">
                                    <Run Text="{Binding SurfaceIds.Count, Mode=OneWay}" /><Run Text=" surfaces concernées · clic ou Entrée pour isoler, reclic pour quitter" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushStatusSeen}"
                                           Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="Résolu : absent de l'analyse. Vu pour la dernière fois le " /><Run Text="{Binding ResolvedSince, Mode=OneWay}" />
                                </TextBlock>

                                <Border Margin="0,12,0,0" Background="{DynamicResource BrushBackground}" CornerRadius="{StaticResource RadiusControl}" Padding="2"
                                        IsEnabled="{Binding IsOpen}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Status" Content="À traiter"
                                                     IsChecked="{Binding Status, Converter={StaticResource EqualsTo}, ConverterParameter=ToReview}" ToolTip="1" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Status" Content="Vu"
                                                     IsChecked="{Binding Status, Converter={StaticResource EqualsTo}, ConverterParameter=Seen}" ToolTip="2" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Status" Content="Faux positif"
                                                     IsChecked="{Binding Status, Converter={StaticResource EqualsTo}, ConverterParameter=FalsePositive}" ToolTip="3" />
                                    </UniformGrid>
                                </Border>
                                <ui:TextBox Margin="0,8,0,0" PlaceholderText="Commentaire…" AcceptsReturn="True" TextWrapping="Wrap"
                                            MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                            Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Commentaire" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ListBox x:Name="IssuesList" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}"
                                     ItemContainerStyle="{StaticResource IssueItem}" Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="IssuesList_Click" PreviewKeyDown="IssuesList_PreviewKeyDown"
                                     AutomationProperties.Name="Points d'attention">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:IssueItem">
                                        <Grid ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="600">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <c:VerdictGlyph Verdict="{Binding Verdict}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" Text="{Binding Rule}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" Text="{Binding Location}" VerticalAlignment="Center" />
                                            <!-- Point isolé dans la 3D / point qui cite la surface cliquée -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0">
                                                <ui:SymbolIcon Symbol="Eye16" Foreground="{DynamicResource BrushAccent}" ToolTip="Isolé dans la 3D — recliquer pour quitter"
                                                               Visibility="{Binding IsFocused, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:SymbolIcon Symbol="Link16" Foreground="{DynamicResource BrushAccent}" ToolTip="Cite la surface sélectionnée dans la 3D"
                                                               Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Style="{StaticResource TextNumber}" VerticalAlignment="Center"
                                                       Text="{Binding DiffM2, Converter={StaticResource Area}}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource TextBody}" Text="{Binding Title}" />
                                            <Button Grid.Row="1" Grid.Column="4" Margin="8,1,0,1" HorizontalAlignment="Right" Style="{StaticResource RowButton}" Padding="0"
                                                    Command="{Binding DataContext.ShowSubjectOfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasSubjectLink}" ToolTip="{Binding AiReason}">
                                                <c:AiVerdictTag Kind="{Binding AiKind}" Text="{Binding AiTag}" />
                                            </Button>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource TextCaption}" Text="{Binding Message}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IssuesEmptyMessage, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource TextBody}" HorizontalAlignment="Center" Text="{Binding IssuesEmptyMessage}" />
                                <Button Style="{StaticResource RowButton}" Padding="4,2" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Command="{Binding ResetFiltersCommand}">
                                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Réinitialiser les filtres" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                    </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Barre d'état -->
            <Border Grid.Row="3" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0" Padding="16,4">
                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding StatusText}" />
            </Border>
        </Grid>

        <!-- ================================================================ ANALYSE EN COURS (superposition) -->
        <Grid Grid.Row="1" Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{DynamicResource BrushBackground}" Opacity="0.7" />
            <Border Style="{StaticResource Card}" Background="{DynamicResource BrushSurface}" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource SpaceXL}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextSubtitle}" TextWrapping="Wrap" Text="{Binding OverlayTitle}" />
                    <TextBlock Margin="0,12,0,4" Style="{StaticResource TextBody}" Text="{Binding AnalysisLabel}" />
                    <ProgressBar Minimum="0" Maximum="{Binding OverlayStepCount}" Value="{Binding AnalysisStep}" Height="4" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource TextCaption}" Text="{Binding AnalysisCorrections}"
                               Visibility="{Binding AnalysisCorrections, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}">
                        <Run Text="Étape " /><Run Text="{Binding AnalysisStep, Mode=OneWay}" /><Run Text=" sur " /><Run Text="{Binding OverlayStepCount, Mode=OneWay}" /><Run Text=" : " /><Run Text="{Binding OverlayStepsText, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Right" Appearance="Secondary" Content="Annuler"
                               Command="{Binding CancelAnalysisCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================ REVUE IA (superposition) -->
        <Grid Grid.Row="1" Visibility="{Binding IsAiPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{DynamicResource BrushBackground}" Opacity="0.7" />
            <Border Style="{StaticResource Card}" Background="{DynamicResource BrushSurface}" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource SpaceXL}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss20}" Padding="4"
                                   Command="{Binding CloseAiPanelCommand}" ToolTip="Fermer (annule la revue en cours)"
                                   AutomationProperties.Name="Fermer la revue IA" />
                        <TextBlock Style="{StaticResource TextSubtitle}" VerticalAlignment="Center">
                            <Run Text="Revue IA de " /><Run Text="{Binding ProjectName, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <!-- Clé API : chiffrée DPAPI, jamais affichée en clair -->
                    <TextBlock Style="{StaticResource TextSection}" Text="Clé API Anthropic" />
                    <DockPanel Visibility="{Binding IsReplacingKey, Converter={StaticResource HiddenWhen}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsAiIdle}">
                            <ui:Button Appearance="Secondary" Content="Remplacer" Command="{Binding ReplaceApiKeyCommand}" MinHeight="{StaticResource TargetSize}" />
                            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Content="Oublier" Command="{Binding ForgetApiKeyCommand}" MinHeight="{StaticResource TargetSize}"
                                       ToolTip="Supprime la clé chiffrée de ce poste" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBody}">
                            <Run Text="Clé enregistrée  " /><Run Text="{Binding ApiKeyMasked, Mode=OneWay}" FontFamily="{StaticResource FontMono}" />
                        </TextBlock>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsReplacingKey, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Secondary" Content="Enregistrer"
                                   Click="SaveApiKey_Click" MinHeight="{StaticResource TargetSize}" />
                        <ui:PasswordBox x:Name="ApiKeyBox" PlaceholderText="sk-ant-…" FontFamily="{StaticResource FontMono}"
                                        AutomationProperties.Name="Clé API Anthropic" KeyDown="ApiKeyBox_KeyDown" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Text="Chiffrée pour votre compte Windows (DPAPI), jamais écrite en clair ni dans le dépôt." />

                    <!-- Étapes -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="{DynamicResource BrushStatusSeen}" Visibility="{Binding AiAnalysisDone, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center" Text="Analyse sia-check" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding AiStepAnalysis}" />
                        <ui:SymbolIcon Grid.Row="1" Symbol="CheckmarkCircle20" Foreground="{DynamicResource BrushStatusSeen}" Visibility="{Binding AiAnalysisDone, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center" Text="Preuves géométriques" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding AiStepEvidence}" />
                        <ui:SymbolIcon Grid.Row="2" Symbol="CheckmarkCircle20" Foreground="{DynamicResource BrushStatusSeen}" Visibility="{Binding AiEstimateDone, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center" Text="Estimation du coût" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding AiStepEstimate}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center">
                            <Run Text="Rédaction par " /><Run Text="{Binding AiModelLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding AiStepWriting}" />
                    </Grid>
                    <ProgressBar Margin="0,4,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding AiProgress}"
                                 IsIndeterminate="{Binding AiProgressKnown, Converter={StaticResource EqualsTo}, ConverterParameter=False}"
                                 Visibility="{Binding IsAiWriting, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Coût et confidentialité -->
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource TextSubtitle}" Text="{Binding AiCostText}"
                               Visibility="{Binding AiCostText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Text="Envoyés à l'API Anthropic : les preuves chiffrées (aires, identifiants de surfaces et de niveaux), pas la géométrie ni le fichier .tgm. Tarif Claude Opus 5.5 : 4 USD par million de jetons en entrée, 20 USD en sortie." />

                    <Border Style="{StaticResource Banner}" BorderBrush="{DynamicResource BrushVerdictError}" Margin="0,12,0,0"
                            Visibility="{Binding HasAiError, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Padding="4,0" VerticalAlignment="Top" Command="{Binding OpenAiErrorLogCommand}"
                                    ToolTip="Message, détail technique et réponse brute du modèle (derniere-erreur.log), sinon journal du moteur">
                                <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushAccent}" Text="Voir le journal" />
                            </Button>
                            <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Text="{Binding AiError}" />
                        </DockPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary" Content="Annuler" Command="{Binding CancelAiReviewCommand}"
                                   Visibility="{Binding IsAiRunning, Converter={StaticResource BoolToVisibility}}" MinHeight="{StaticResource TargetSize}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Send20}" Content="Envoyer à Claude"
                                   Command="{Binding ConfirmAiReviewCommand}" MinHeight="{StaticResource TargetSize}"
                                   Visibility="{Binding IsAwaitingConfirm, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Play20}" Content="Lancer la revue"
                                   Command="{Binding StartAiReviewCommand}" IsEnabled="{Binding CanStartAiReview}" MinHeight="{StaticResource TargetSize}"
                                   Visibility="{Binding IsAiIdle, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Analyse, preuves et estimation du coût : rien n'est envoyé à Claude avant votre accord" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="1" VerticalAlignment="Bottom" />
    </Grid>
</ui:FluentWindow>
