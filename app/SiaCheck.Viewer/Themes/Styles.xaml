<!-- Styles partagés : dérivés exclusivement des tokens (Tokens.xaml, Colors.*.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ===== Texte ===== -->
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontFamily" Value="{StaticResource FontUISemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    </Style>
    <Style x:Key="TextSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontFamily" Value="{StaticResource FontUISemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <!-- Codes SIA, règles, niveaux, identifiants : toujours en mono (plan §2, « voix » de l'outil) -->
    <Style x:Key="TextMono" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
    </Style>
    <Style x:Key="TextNumber" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <!-- En-tête de section de panneau : petites capitales, secondaire -->
    <Style x:Key="TextSection" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
        <Setter Property="FontFamily" Value="{StaticResource FontUISemibold}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="{StaticResource SectionGap}" />
    </Style>

    <!-- ===== Panneaux ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>
    <!-- Bandeau d'avertissement superposé à la 3D -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushVerdictWarning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
        <Setter Property="Margin" Value="{StaticResource SpaceM}" />
    </Style>

    <!-- ===== Puce bâtiment (bascule) ===== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="{StaticResource TargetSize}" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}"
                            BorderThickness="1" BorderBrush="Transparent" Padding="8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Bascule de verdict (filtre) : glyphe contouré + compteur ===== -->
    <Style x:Key="VerdictToggle" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- ===== Contrôle segmenté (statut) ===== -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="{StaticResource TargetSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ligne cliquable (bilan, récents) ===== -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Liste des points d'attention ===== -->
    <Style x:Key="IssueItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
