<!-- Tokens hors couleurs d'interface — docs/DESIGN_PLAN.md §2. Aucune valeur en dur dans les vues. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Légende SIA 416 : couleurs de CONTENU, identiques dans les deux thèmes -->
    <Color x:Key="ColorSIA_SP">#B1005D</Color>
    <Color x:Key="ColorSIA_SUP">#D5003B</Color>
    <Color x:Key="ColorSIA_SUS">#F0A900</Color>
    <Color x:Key="ColorSIA_SD">#F2E900</Color>
    <Color x:Key="ColorSIA_SI">#0C9DDA</Color>
    <Color x:Key="ColorSIA_Ignored">#6B7280</Color>

    <!-- Typographie -->
    <FontFamily x:Key="FontUI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontUISemibold">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeMono">12</sys:Double>

    <!-- Espacement : grille 4 px (densité production : M = 12) -->
    <sys:Double x:Key="SpaceXSValue">4</sys:Double>
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
    <Thickness x:Key="PanelPadding">12,12,12,12</Thickness>
    <Thickness x:Key="RowPadding">8,6,8,6</Thickness>
    <Thickness x:Key="SectionGap">0,16,0,8</Thickness>

    <!-- Formes -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>

    <!-- Dimensions de l'espace de revue -->
    <GridLength x:Key="LayersPanelWidth">280</GridLength>
    <sys:Double x:Key="IssuesPanelMinWidth">320</sys:Double>
    <sys:Double x:Key="BalanceHeight">220</sys:Double>
    <sys:Double x:Key="BalanceRowHeight">18</sys:Double>
    <sys:Double x:Key="TargetSize">32</sys:Double>
    <sys:Double x:Key="SwatchSize">12</sys:Double>
    <sys:Double x:Key="WindowMinWidth">1400</sys:Double>
    <sys:Double x:Key="WindowMinHeight">860</sys:Double>
    <!-- Accueil : Fiabilisation | Benchmark (Évolution 3.0) -->
    <sys:Double x:Key="HomeMaxWidth">1360</sys:Double>
    <Thickness x:Key="HomeMargin">24,48,24,24</Thickness>
    <Thickness x:Key="HomeColumnLeft">0,0,32,0</Thickness>
    <Thickness x:Key="HomeColumnRight">32,0,0,0</Thickness>
    <!-- Empreinte de fiabilité d'un MDP : un segment par contrôle -->
    <sys:Double x:Key="FingerprintWidth">6</sys:Double>
    <sys:Double x:Key="FingerprintHeight">12</sys:Double>
    <Thickness x:Key="FingerprintGap">0,0,2,0</Thickness>
</ResourceDictionary>
