<!-- Couleurs d'interface, thème clair — docs/DESIGN_PLAN.md §2. Mêmes clés que Colors.Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#F3F4F6</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceRaised">#E9EBEF</Color>
    <Color x:Key="ColorTextPrimary">#1B1E24</Color>
    <Color x:Key="ColorTextSecondary">#5D6470</Color>
    <Color x:Key="ColorAccent">#5A50D6</Color>
    <Color x:Key="ColorOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorVerdictError">#C62F2F</Color>
    <Color x:Key="ColorVerdictWarning">#9A6700</Color>
    <Color x:Key="ColorVerdictInfo">#4F6380</Color>
    <Color x:Key="ColorStatusSeen">#1E7F52</Color>
    <Color x:Key="ColorDivider">#DADDE3</Color>
    <Color x:Key="ColorGhost">#265D6470</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="BrushVerdictError" Color="{StaticResource ColorVerdictError}" />
    <SolidColorBrush x:Key="BrushVerdictWarning" Color="{StaticResource ColorVerdictWarning}" />
    <SolidColorBrush x:Key="BrushVerdictInfo" Color="{StaticResource ColorVerdictInfo}" />
    <SolidColorBrush x:Key="BrushStatusSeen" Color="{StaticResource ColorStatusSeen}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
</ResourceDictionary>
