<!-- Thème « Mint sombre » — inverse de Mint (fresh &amp; refreshing, source : @uiuxaadi · DfKLpS_FLbN), mêmes clés que les autres
     Colors.*.xaml. Dérivé des teintes de la palette (texte #0B3D3B, accent #14B8A6, primaire #99F6E4, surface #E6FFFB, fond #F8FFFE) :
     les fonds sont le texte de la palette assombri vers le noir, le texte est sa surface (ou son fond), l'accent reste
     l'accent ; les autres tons sont des mélanges de ces teintes. Hors palette, seules les couleurs d'état et la couleur
     de contenu SA, reprises de Pervenche sombre. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fond de page et de la vue 3D -->
    <Color x:Key="ColorBackground">#041716</Color>
    <!-- Panneaux et menus -->
    <Color x:Key="ColorSurface">#062220</Color>
    <!-- Cartes, survol, puces -->
    <Color x:Key="ColorSurfaceRaised">#09302E</Color>
    <Color x:Key="ColorTextPrimary">#E6FFFB</Color>
    <!-- Texte secondaire : 66 % de texte sur le fond (≥ 4,5:1 sur panneaux, cartes et sélection) -->
    <Color x:Key="ColorTextSecondary">#99B0AD</Color>
    <Color x:Key="ColorAccent">#14B8A6</Color>
    <!-- Texte des boutons sur l'accent : le texte de la palette, comme en clair -->
    <Color x:Key="ColorOnAccent">#0B3D3B</Color>
    <!-- Liens et icônes d'action : l'accent éclairci de moitié vers la primaire -->
    <Color x:Key="ColorAccentText">#56D7C5</Color>
    <Color x:Key="ColorVerdictError">#F27272</Color>
    <Color x:Key="ColorVerdictWarning">#E8B04A</Color>
    <!-- Information : pas une couleur d'état, donc le texte secondaire -->
    <Color x:Key="ColorVerdictInfo">#99B0AD</Color>
    <Color x:Key="ColorStatusSeen">#59C28F</Color>
    <!-- Couleur de contenu : abords SA (légende SIA 416 §1.2), découpes vers SA (Évolution 2.0) -->
    <Color x:Key="ColorSiaSA">#5BA845</Color>
    <Color x:Key="ColorContext">#3899B0AD</Color>
    <!-- Filets : 13 % de texte sur le panneau -->
    <Color x:Key="ColorDivider">#233F3C</Color>
    <!-- Fantôme 3D : surfaces hors du point d'attention isolé -->
    <Color x:Key="ColorGhost">#1C99B0AD</Color>
    <!-- Puce cochée (bâtiment, onglet, filtre) : 22 % d'accent sur le panneau, bordée d'accent -->
    <Color x:Key="ColorSelected">#09433D</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="BrushVerdictError" Color="{StaticResource ColorVerdictError}" />
    <SolidColorBrush x:Key="BrushVerdictWarning" Color="{StaticResource ColorVerdictWarning}" />
    <SolidColorBrush x:Key="BrushVerdictInfo" Color="{StaticResource ColorVerdictInfo}" />
    <SolidColorBrush x:Key="BrushStatusSeen" Color="{StaticResource ColorStatusSeen}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
    <SolidColorBrush x:Key="BrushSiaSA" Color="{StaticResource ColorSiaSA}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />
    <SolidColorBrush x:Key="BrushSelected" Color="{StaticResource ColorSelected}" />
    <SolidColorBrush x:Key="BrushOnSelected" Color="{StaticResource ColorTextPrimary}" />

    <!-- ===== Contrôles WPF-UI (boutons, listes, champs, menus) : gris neutres du thème Fluent sombre et texte blanc sur
         l'accent. App.ApplyTheme recopie ces clés au premier niveau, devant le thème et l'accent. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#041716" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#132F2D" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1C3836" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#062220" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#041716" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#132F2D" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#132F2D" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1C3836" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#062220" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#062220" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#062220" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#09302E" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#062220" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#09302E" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#233F3C" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E6FFFB" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#99B0AD" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#758B88" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#99B0AD" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="#E6FFFB" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#E6FFFB" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E6FFFB" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#E6FFFB" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B3D3B" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#56D7C5" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#56D7C5" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#56D7C5" />
</ResourceDictionary>
