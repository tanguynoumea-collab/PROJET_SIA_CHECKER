<!-- Couleurs d'interface, thème sombre (défaut) — docs/DESIGN_PLAN.md §2. Mêmes clés que Colors.Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#15171C</Color>
    <Color x:Key="ColorSurface">#1E2128</Color>
    <Color x:Key="ColorSurfaceRaised">#272B33</Color>
    <Color x:Key="ColorTextPrimary">#E7E9EE</Color>
    <Color x:Key="ColorTextSecondary">#9BA1AD</Color>
    <Color x:Key="ColorAccent">#8B83FF</Color>
    <Color x:Key="ColorOnAccent">#15171C</Color>
    <Color x:Key="ColorVerdictError">#F27272</Color>
    <Color x:Key="ColorVerdictWarning">#E8B04A</Color>
    <Color x:Key="ColorVerdictInfo">#8FA3BF</Color>
    <Color x:Key="ColorStatusSeen">#59C28F</Color>
    <!-- Couleur de contenu : abords SA (légende SIA 416 §1.2), découpes vers SA (Évolution 2.0) -->
    <Color x:Key="ColorSiaSA">#5BA845</Color>
    <Color x:Key="ColorDivider">#2E323B</Color>
    <!-- Fantôme 3D : surfaces hors du point d'attention isolé -->
    <Color x:Key="ColorGhost">#1C9BA1AD</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="BrushVerdictError" Color="{StaticResource ColorVerdictError}" />
    <SolidColorBrush x:Key="BrushVerdictWarning" Color="{StaticResource ColorVerdictWarning}" />
    <SolidColorBrush x:Key="BrushVerdictInfo" Color="{StaticResource ColorVerdictInfo}" />
    <SolidColorBrush x:Key="BrushStatusSeen" Color="{StaticResource ColorStatusSeen}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
    <SolidColorBrush x:Key="BrushSiaSA" Color="{StaticResource ColorSiaSA}" />
</ResourceDictionary>
