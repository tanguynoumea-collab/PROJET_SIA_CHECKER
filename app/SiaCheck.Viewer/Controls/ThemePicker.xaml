<UserControl x:Class="SiaCheck.Viewer.Controls.ThemePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Choix du thème : un bouton-icône (accueil, barre du projet) et un volet de vignettes, une ligne par palette -->
    <UserControl.Resources>
        <!-- Vignette : aperçu du thème (fond, panneau, lignes de texte, bouton d'accent) et son mode -->
        <Style x:Key="ThemeTile" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Border x:Name="Frame" Width="132" Height="76" CornerRadius="{StaticResource RadiusCard}" Padding="2"
                                    BorderThickness="1" BorderBrush="{DynamicResource BrushDivider}">
                                <Border CornerRadius="4" Background="{Binding Background}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Surface}" BorderBrush="{Binding Divider}" BorderThickness="0,0,1,0">
                                            <StackPanel Margin="6,10,6,0">
                                                <Border Height="4" CornerRadius="2" Background="{Binding Text}" Margin="0,0,6,6" />
                                                <Border Height="4" CornerRadius="2" Background="{Binding Text2}" Margin="0,0,0,6" />
                                                <Border Height="4" CornerRadius="2" Background="{Binding Text2}" Margin="0,0,10,0" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,10,10,0">
                                            <Border Height="6" CornerRadius="3" Background="{Binding Text}" Margin="0,0,24,8" />
                                            <Border Height="4" CornerRadius="2" Background="{Binding Text2}" Margin="0,0,8,0" />
                                            <Border Width="34" Height="14" Margin="0,14,0,0" HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{Binding Accent}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <DockPanel Margin="2,4,0,0">
                                <ui:SymbolIcon x:Name="Check" DockPanel.Dock="Right" Symbol="Checkmark16" Margin="0,0,2,0"
                                               Foreground="{DynamicResource BrushAccentText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Variant}" />
                            </DockPanel>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Frame" Property="Padding" Value="1" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ui:Button x:Name="Toggle" Appearance="Transparent" Icon="{ui:SymbolIcon Color20}" Click="Toggle_Click"
                   ToolTip="Thème de l'interface" AutomationProperties.Name="Thème"
                   MinWidth="{StaticResource TargetSize}" MinHeight="{StaticResource TargetSize}" />
        <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="Flyout_Closed">
            <!-- Marge : place de l'ombre -->
            <Border Margin="12" Padding="16,12,8,4" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                    KeyDown="Flyout_KeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,8" Text="Thème" />
                    <ItemsControl x:Name="Families" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource TextBody}" Margin="0,0,0,6" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ThemeTile}" Click="Tile_Click"
                                                        AutomationProperties.Name="{Binding Theme.Label}" ToolTip="{Binding Theme.Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
