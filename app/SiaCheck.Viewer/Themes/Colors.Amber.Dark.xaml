<!-- Thème « Amber sombre » — inverse de Amber (modern &amp; striking, source : @uiuxaadi · DfKLpS_FLbN), mêmes clés que les autres
     Colors.*.xaml. Dérivé des teintes de la palette (texte #1F1D2B, accent #FF7A00, primaire #FFA94D, surface #FFE4C7, fond #FFF8EF) :
     les fonds sont le texte de la palette assombri vers le noir, le texte est sa surface (ou son fond), l'accent reste
     l'accent ; les autres tons sont des mélanges de ces teintes. Hors palette, seules les couleurs d'état et la couleur
     de contenu SA, reprises de Pervenche sombre. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fond de page et de la vue 3D -->
    <Color x:Key="ColorBackground">#14131C</Color>
    <!-- Panneaux et menus -->
    <Color x:Key="ColorSurface">#1F1D2B</Color>
    <!-- Cartes, survol, puces -->
    <Color x:Key="ColorSurfaceRaised">#2F2B36</Color>
    <Color x:Key="ColorTextPrimary">#FFF8EF</Color>
    <!-- Texte secondaire : 66 % de texte sur le fond (≥ 4,5:1 sur panneaux, cartes et sélection) -->
    <Color x:Key="ColorTextSecondary">#AFAAA7</Color>
    <Color x:Key="ColorAccent">#FF7A00</Color>
    <!-- Texte des boutons sur l'accent : le texte de la palette, comme en clair -->
    <Color x:Key="ColorOnAccent">#1F1D2B</Color>
    <!-- Liens et icônes d'action : l'accent éclairci de moitié vers la primaire -->
    <Color x:Key="ColorAccentText">#FF9226</Color>
    <Color x:Key="ColorVerdictError">#F27272</Color>
    <Color x:Key="ColorVerdictWarning">#E8B04A</Color>
    <!-- Information : pas une couleur d'état, donc le texte secondaire -->
    <Color x:Key="ColorVerdictInfo">#AFAAA7</Color>
    <Color x:Key="ColorStatusSeen">#59C28F</Color>
    <!-- Couleur de contenu : abords SA (légende SIA 416 §1.2), découpes vers SA (Évolution 2.0) -->
    <Color x:Key="ColorSiaSA">#5BA845</Color>
    <Color x:Key="ColorContext">#38AFAAA7</Color>
    <!-- Filets : 13 % de texte sur le panneau -->
    <Color x:Key="ColorDivider">#3C3944</Color>
    <!-- Fantôme 3D : surfaces hors du point d'attention isolé -->
    <Color x:Key="ColorGhost">#1CAFAAA7</Color>
    <!-- Puce cochée (bâtiment, onglet, filtre) : 22 % d'accent sur le panneau, bordée d'accent -->
    <Color x:Key="ColorSelected">#503122</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="BrushVerdictError" Color="{StaticResource ColorVerdictError}" />
    <SolidColorBrush x:Key="BrushVerdictWarning" Color="{StaticResource ColorVerdictWarning}" />
    <SolidColorBrush x:Key="BrushVerdictInfo" Color="{StaticResource ColorVerdictInfo}" />
    <SolidColorBrush x:Key="BrushStatusSeen" Color="{StaticResource ColorStatusSeen}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
    <SolidColorBrush x:Key="BrushSiaSA" Color="{StaticResource ColorSiaSA}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />
    <SolidColorBrush x:Key="BrushSelected" Color="{StaticResource ColorSelected}" />
    <SolidColorBrush x:Key="BrushOnSelected" Color="{StaticResource ColorTextPrimary}" />

    <!-- ===== Contrôles WPF-UI (boutons, listes, champs, menus) : gris neutres du thème Fluent sombre et texte blanc sur
         l'accent. App.ApplyTheme recopie ces clés au premier niveau, devant le thème et l'accent. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#14131C" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2C2A37" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#35333F" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#1F1D2B" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#14131C" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#2C2A37" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2C2A37" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#35333F" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#1F1D2B" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#1F1D2B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1F1D2B" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2F2B36" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1F1D2B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2F2B36" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#3C3944" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF8EF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#AFAAA7" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8686" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#AFAAA7" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="#FFF8EF" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFF8EF" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#FFF8EF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFF8EF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1F1D2B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1F1D2B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#1F1D2B" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1F1D2B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1F1D2B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1F1D2B" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF9226" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF9226" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF9226" />
</ResourceDictionary>
